{
 "sales_existing_p1.json": {
  "tool": "mcp__PropertyIndex__propertyindex_query",
  "input": {
   "entity": "sales",
   "filters": [
    {
     "field": "location_id",
     "operator": "eq",
     "value": "71"
    },
    {
     "field": "market_basis",
     "operator": "eq",
     "value": "existing"
    }
   ],
   "select": [
    "sale_date",
    "location_name",
    "location_slug",
    "tower",
    "floor",
    "bedrooms",
    "size_sqft",
    "sale_price",
    "sale_psf",
    "market_basis",
    "prior_sale_relation",
    "price_tier"
   ],
   "orderBy": [
    {
     "field": "sale_date",
     "direction": "desc"
    },
    {
     "field": "location_slug",
     "direction": "asc"
    },
    {
     "field": "sale_price",
     "direction": "desc"
    }
   ],
   "limit": 100
  }
 },
