 "rentals_p1.json": {
  "tool": "mcp__PropertyIndex__propertyindex_query",
  "input": {
   "entity": "rentals",
   "select": [
    "registration_date",
    "start_date",
    "end_date",
    "location_name",
    "location_slug",
    "tower",
    "bedrooms",
    "size_sqft",
    "annual_rent",
    "annual_rent_psf",
    "is_new_contract",
    "url"
   ],
   "filters": [
    {
     "field": "location_id",
     "operator": "eq",
     "value": "71"
    },
    {
     "field": "property_type",
     "operator": "in",
     "value": [
      "Apartment",
      "Hotel Apartment"
     ]
    }
   ],
   "orderBy": [
    {
     "field": "registration_date",
     "direction": "desc"
