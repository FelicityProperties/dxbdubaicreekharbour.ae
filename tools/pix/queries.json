 "sales_12m_by_building_p1.json": {
  "tool": "mcp__PropertyIndex__propertyindex_query",
  "input": {
   "entity": "sales",
   "filters": [
    {
     "field": "location_id",
     "operator": "eq",
     "value": "71"
    },
    {
     "field": "sale_date",
     "operator": "between",
     "value": [
      "2025-11-01",
      "2026-10-31"
     ]
    },
    {
     "field": "prior_sale_relation",
     "operator": "neq",
     "value": "no_party_link"
    },
    {
     "field": "prior_sale_relation",
     "operator": "neq",
     "value": "prior_buyer_retained"
    }
   ],
   "select": [
    "location_slug",
    "location_name",
    "market_basis"
   ],
   "groupBy": [
    "location_slug",
    "location_name",
    "market_basis"
   ],
   "measures": [
    {
     "field": "rows",
     "aggregate": "count"
    },
    {
     "field": "sale_psf",
     "aggregate": "median"
    },
    {
     "field": "sale_price",
     "aggregate": "median"
    }
   ],
   "orderBy": [
    {
     "field": "rows",
     "aggregate": "count",
     "direction": "desc"
    },
    {
     "field": "location_slug",
     "direction": "asc"
    },
    {
     "field": "market_basis",
     "direction": "asc"
    }
   ],
   "limit": 100
  }
 },
